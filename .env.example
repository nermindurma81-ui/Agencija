# ============================================================================
# GEMINI CONFIGURATION (Google AI)
# ============================================================================
# Get your Gemini API key from: https://aistudio.google.com/app/apikey
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================================
# OPENROUTER CONFIGURATION (Multi-model provider)
# ============================================================================
# Get your OpenRouter API key from: https://openrouter.ai/keys
# Supports: Gemini, Claude, Llama, Mistral, and 200+ other models
# Free tier available for many models
OPENROUTER_KEY=sk-or-your-openrouter-key-here
NEXT_PUBLIC_OPENROUTER_KEY=sk-or-your-openrouter-key-here

# ============================================================================
# HUGGINGFACE CONFIGURATION (Open source models)
# ============================================================================
# Get your HuggingFace token from: https://huggingface.co/settings/tokens
# Supports: Llama, Mistral, Gemma, Phi, Qwen, and other open models
# Free tier: ~1000 requests/day
HF_TOKEN=hf_your_huggingface_token_here

# ============================================================================
# OLLAMA CONFIGURATION (Local models)
# ============================================================================
# Ollama URL for local model serving
# Default: http://localhost:11434
# Download Ollama from: https://ollama.ai
OLLAMA_URL=http://localhost:11434

# ============================================================================
# FIREBASE CONFIGURATION
# ============================================================================
# Get these from your Firebase project settings
# https://console.firebase.google.com
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_FIRESTORE_DATABASE_ID=(default)

# ============================================================================
# DEPLOYMENT & INTEGRATION TOKENS (Optional)
# ============================================================================
# GitHub token for repository operations
# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_github_token_here

# Netlify token for static site deployment
# Get from: https://app.netlify.com/user/applications
NETLIFY_TOKEN=nfp_your_netlify_token_here

# Vercel token for Next.js deployment
# Get from: https://vercel.com/account/tokens
VERCEL_TOKEN=your_vercel_token_here

# Railway token for backend deployment
# Get from: https://railway.app/dashboard/tokens
RAILWAY_TOKEN=your_railway_token_here

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Application URL (for self-referential links)
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=http://localhost:3000

# Disable HMR during development (optional)
# DISABLE_HMR=false

# ============================================================================
# NOTES
# ============================================================================
# 1. Copy this file to .env.local and fill in your actual keys
# 2. Never commit .env.local to version control
# 3. For local development, you can use free tiers from most providers
# 4. For production, use environment variables from your hosting provider
# 5. Some providers (OpenRouter, HuggingFace) have free tier models
# 6. Ollama requires local installation for offline model serving
