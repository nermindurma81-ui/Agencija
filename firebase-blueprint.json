{
  "entities": {
    "CustomModel": {
      "title": "CustomModel",
      "description": "A user-created super model combining multiple agents",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "systemInstruction": { "type": "string" },
        "baseModels": { "type": "array", "items": { "type": "string" } },
        "tools": { "type": "array", "items": { "type": "string" } },
        "userId": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "systemInstruction", "userId"]
    },
    "CustomTool": {
      "title": "CustomTool",
      "description": "A user-uploaded tool with JS code",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "parametersSchema": { "type": "string" },
        "jsCode": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "description", "parametersSchema", "jsCode", "userId"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "A chat session with an agent",
      "type": "object",
      "properties": {
        "agentId": { "type": "string" },
        "userId": { "type": "string" },
        "messages": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["agentId", "userId", "messages", "updatedAt"]
    },
    "UsageLog": {
      "title": "UsageLog",
      "description": "Log of agent usage for analytics and rate limiting",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "agentId": { "type": "string" },
        "model": { "type": "string" },
        "provider": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["userId", "agentId", "model", "provider", "timestamp"]
    },
    "StudioRun": {
      "title": "StudioRun",
      "description": "A persisted orchestration run stored for an authenticated user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "workflowId": { "type": "string" },
        "workflowName": { "type": "string" },
        "query": { "type": "string" },
        "selectedAgentName": { "type": "string" },
        "selectedAgentPath": { "type": "string" },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "usedWebResearch": { "type": "boolean" },
        "skillId": { "type": "string" },
        "final": { "type": "string" },
        "stages": { "type": "array", "items": { "type": "object" } },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "workflowId", "workflowName", "query", "selectedAgentName", "selectedAgentPath", "provider", "model", "final"]
    },
    "SkillBrain": {
      "title": "SkillBrain",
      "description": "A reusable orchestration profile with a custom operational prompt",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "systemPrompt": { "type": "string" },
        "preferredWorkflowId": { "type": "string" },
        "providerOverride": { "type": "string" },
        "modelOverride": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "name", "description", "systemPrompt"]
    }
  },
  "firestore": {
    "/customModels/{modelId}": {
      "schema": { "$ref": "#/entities/CustomModel" },
      "description": "User created super models"
    },
    "/customTools/{toolId}": {
      "schema": { "$ref": "#/entities/CustomTool" },
      "description": "User created tools"
    },
    "/chatSessions/{sessionId}": {
      "schema": { "$ref": "#/entities/ChatSession" },
      "description": "User chat sessions"
    },
    "/usageLogs/{logId}": {
      "schema": { "$ref": "#/entities/UsageLog" },
      "description": "Usage logs for analytics"
    },
    "/studioRuns/{runId}": {
      "schema": { "$ref": "#/entities/StudioRun" },
      "description": "Persistent orchestration runs"
    },
    "/skillBrains/{skillId}": {
      "schema": { "$ref": "#/entities/SkillBrain" },
      "description": "Reusable skill brain profiles"
    }
  }
}
